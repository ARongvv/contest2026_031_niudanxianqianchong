<template>
  <div class="app">
    <div class="screensaver" if="{{ locked }}" onclick="unlock">
      <text class="lock-time">09:30</text>
      <text class="lock-date">9月24日 星期三</text>
      <div class="lock-weather">
        <text class="weather-symbol">☁</text>
        <text class="lock-temperature">26°</text>
        <text class="lock-copy">多云 · 湿度 62%</text>
      </div>
      <text class="swipe-hint">↑ 上滑进入我的家</text>
    </div>

    <div class="panel" if="{{ !locked }}">

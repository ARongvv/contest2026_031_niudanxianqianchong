############################################################################
# packages/cagent_addons/Makefile
#
# cAGENT addon package for NuttX/openvela.
# Layering: src/node builds without CAGENT; src/glue and src/mcp require it.
############################################################################

include $(APPDIR)/Make.defs

CFLAGS += ${INCDIR_PREFIX}$(CURDIR)/include
CFLAGS += -DCAGENT_ADDONS_MAX_PUBLIC_NAME_SIZE=$(CONFIG_CAGENT_ADDONS_MAX_PUBLIC_NAME_SIZE)
CFLAGS += -DCAGENT_ADDONS_MAX_DESCRIPTION_SIZE=$(CONFIG_CAGENT_ADDONS_MAX_DESCRIPTION_SIZE)
CFLAGS += -DCAGENT_ADDONS_MAX_SCHEMA_SIZE=$(CONFIG_CAGENT_ADDONS_MAX_SCHEMA_SIZE)
CFLAGS += -DCAGENT_ADDONS_MAX_RESULT_SIZE=$(CONFIG_CAGENT_ADDONS_MAX_RESULT_SIZE)

CSRCS += src/common/errors.c

# Protocol layer: no CAGENT dependency
ifeq ($(CONFIG_CAGENT_ADDONS_NODE),y)
CFLAGS += -DCAGENT_ADDONS_MAX_NODE_COMMANDS=$(CONFIG_CAGENT_ADDONS_MAX_NODE_COMMANDS)
CFLAGS += -DCAGENT_ADDONS_RECV_BUF_SIZE=$(CONFIG_CAGENT_ADDONS_RECV_BUF_SIZE)
CFLAGS += -DCAGENT_ADDONS_WS_CONNECT_TIMEOUT_MS=$(CONFIG_CAGENT_ADDONS_WS_CONNECT_TIMEOUT_MS)
CFLAGS += -DCAGENT_ADDONS_WS_IO_TIMEOUT_MS=$(CONFIG_CAGENT_ADDONS_WS_IO_TIMEOUT_MS)
CFLAGS += -DCAGENT_ADDONS_TRANSPORT_STACK_SIZE=$(CONFIG_CAGENT_ADDONS_TRANSPORT_STACK_SIZE)
CSRCS += src/transport/ws_transport.c
CSRCS += src/node/ws_frame.c
CSRCS += src/node/node_proto.c
endif

ifeq ($(CONFIG_CAGENT_ADDONS_NODE_CLIENT),y)
CFLAGS += -DCAGENT_ADDONS_NODE_CLIENT_STACK_SIZE=$(CONFIG_CAGENT_ADDONS_NODE_CLIENT_STACK_SIZE)
CFLAGS += -DCAGENT_ADDONS_NODE_QUEUE_SIZE=$(CONFIG_CAGENT_ADDONS_NODE_QUEUE_SIZE)
CSRCS += src/node/node_client.c
endif

# Glue layer: requires CAGENT. MCP and the Node gateway share the
# remote-tool catalog, but either module may be enabled on its own.
ifneq ($(filter y,$(CONFIG_CAGENT_ADDONS_NODE_GATEWAY) $(CONFIG_CAGENT_ADDONS_MCP)),)
CFLAGS += -DCAGENT_ADDONS_MAX_REMOTE_TOOLS=$(CONFIG_CAGENT_ADDONS_MAX_REMOTE_TOOLS)
CSRCS += src/glue/remote_tool.c
endif

ifeq ($(CONFIG_CAGENT_ADDONS_NODE_GATEWAY),y)
CFLAGS += -DCAGENT_ADDONS_MAX_NODES=$(CONFIG_CAGENT_ADDONS_MAX_NODES)
CFLAGS += -DCAGENT_ADDONS_MAX_PENDING=$(CONFIG_CAGENT_ADDONS_MAX_PENDING)
CFLAGS += -DCAGENT_ADDONS_INVOKE_TIMEOUT_MS=$(CONFIG_CAGENT_ADDONS_INVOKE_TIMEOUT_MS)
CFLAGS += -DCAGENT_ADDONS_GATEWAY_STACK_SIZE=$(CONFIG_CAGENT_ADDONS_GATEWAY_STACK_SIZE)
CFLAGS += -DCAGENT_ADDONS_MAX_NODE_TOOLS=$(CONFIG_CAGENT_ADDONS_MAX_NODE_TOOLS)
CSRCS += src/node/node_gateway.c
endif

ifeq ($(CONFIG_CAGENT_ADDONS_MCP),y)
CFLAGS += -DCAGENT_ADDONS_MCP_RESPONSE_BUF_SIZE=$(CONFIG_CAGENT_ADDONS_MCP_RESPONSE_BUF_SIZE)
CFLAGS += -DCAGENT_ADDONS_MAX_MCP_TOOLS=$(CONFIG_CAGENT_ADDONS_MAX_MCP_TOOLS)
CSRCS += src/mcp/mcp_bridge.c
endif

MODULE = $(CONFIG_CAGENT_ADDONS)

include $(APPDIR)/Application.mk

#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config LVX_USE_DEMO_CONTEST2026_031_DSI_PROBE
	bool "ESP32-P4X MIPI-DSI Host probe"
	default n
	select ESPRESSIF_MIPI_DSI
	---help---
		Build dsi_probe, a staged validation program for the
		ESP32-P4X Function EV Board MIPI-DSI Host.  It initializes the
		board PHY and panel reset line, then verifies generic short/long
		packets and the EK79007 initialization write sequence.  The optional
		DCS read diagnostic does not determine pass or failure because the
		panel may not reply before video mode is enabled.

if LVX_USE_DEMO_CONTEST2026_031_DSI_PROBE

config LVX_USE_DEMO_CONTEST2026_031_DSI_PROBE_VIDEO_PATTERN
	bool "Enable dsi_probe DPI colour-bar command"
	depends on ESPRESSIF_SPIRAM
	default n
	select ESPRESSIF_MIPI_DSI_VIDEO
	select ESPRESSIF_MIPI_DSI_VIDEO_DMA
	select ESPRESSIF_MIPI_DSI_DPI_PANEL
	help
		Enable the "dsi_probe video [seconds]" and "dsi_probe pattern
		[seconds]" commands.  Both create the same EK79007-owned RGB565 DPI
		panel lifecycle.  The video command submits framebuffer colour bars
		through draw_bitmap(); the pattern command selects the DSI Host's
		built-in vertical bars so framebuffer pixel contents are bypassed.
		Neither command starts LVGL.

endif # LVX_USE_DEMO_CONTEST2026_031_DSI_PROBE

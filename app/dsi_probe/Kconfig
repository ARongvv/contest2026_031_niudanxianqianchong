#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config LVX_USE_DEMO_CONTEST2026_031_DSI_PROBE
	bool "ESP32-P4X MIPI-DSI command Host probe"
	default n
	select ESPRESSIF_MIPI_DSI
	---help---
		Build dsi_probe, a command-only validation program for the
		ESP32-P4X Function EV Board MIPI-DSI Host.  It initializes the
		board PHY and panel reset line, then verifies generic short/long
		packets and the EK79007 initialization write sequence without
		enabling framebuffer scanout or backlight.  The optional DCS read
		diagnostic does not determine pass or failure because the panel
		may not reply before video mode is enabled.

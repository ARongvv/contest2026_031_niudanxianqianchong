@@ -1089 +1089 @@ static int es8311_configure(FAR struct audio_lowerhalf_s *dev,
-        syslog(LOG_INFO, "INFO: ES8311 configure output: width begin\n");
+        syslog(LOG_DEBUG, "DEBUG: ES8311 configure output: width begin\n");
@@ -1096 +1096 @@ static int es8311_configure(FAR struct audio_lowerhalf_s *dev,
-        syslog(LOG_INFO, "INFO: ES8311 configure output: complete ret=%d\n",
+        syslog(LOG_DEBUG, "DEBUG: ES8311 configure output: complete ret=%d\n",
@@ -1500 +1500 @@ static int es8311_start(FAR struct audio_lowerhalf_s *dev)
-  syslog(LOG_INFO, "INFO: ES8311 start: begin mode=%d\n",

Subject: [PATCH 9/9] audio: demote ES8311 bring-up diagnostics

The diagnostic traces added during codec bring-up are useful only when
explicitly debugging. On this board syslog has no buffering enabled, and
dozens of synchronous INFO writes can stall the serial console before the
first application buffer is queued. Keep error reporting at its existing
level but make success-path ES8311 trace points DEBUG-only.

Apply after 0008-es8311-recover-from-submit-and-mq-errors.patch.

diff --git a/drivers/audio/es8311.c b/drivers/audio/es8311.c
--- a/drivers/audio/es8311.c
+++ b/drivers/audio/es8311.c
@@ -259 +259 @@ uint8_t es8311_readreg(FAR struct es8311_dev_s *priv, uint8_t regaddr)
-      syslog(LOG_INFO, "INFO: ES8311 I2C read begin: reg=0x%02x try=%d\n",
+      syslog(LOG_DEBUG, "DEBUG: ES8311 I2C read begin: reg=0x%02x try=%d\n",
@@ -342 +342 @@ static int es8311_writereg(FAR struct es8311_dev_s *priv,
-      syslog(LOG_INFO,
+      syslog(LOG_DEBUG,
@@ -343 +343 @@ static int es8311_writereg(FAR struct es8311_dev_s *priv,
-             "INFO: ES8311 I2C write begin: reg=0x%02x val=0x%02x try=%d\n",
+             "DEBUG: ES8311 I2C write begin: reg=0x%02x val=0x%02x try=%d\n",
@@ -610 +610 @@ static int es8311_setbitspersample(FAR struct es8311_dev_s *priv)
-  syslog(LOG_INFO, "INFO: ES8311 width: begin bps=%d mode=%d\n",
+  syslog(LOG_DEBUG, "DEBUG: ES8311 width: begin bps=%d mode=%d\n",
@@ -639 +639 @@ static int es8311_setbitspersample(FAR struct es8311_dev_s *priv)
-  syslog(LOG_INFO, "INFO: ES8311 width: I2S RX configured\n");
+  syslog(LOG_DEBUG, "DEBUG: ES8311 width: I2S RX configured\n");
@@ -647 +647 @@ static int es8311_setbitspersample(FAR struct es8311_dev_s *priv)
-  syslog(LOG_INFO, "INFO: ES8311 width: I2S TX configured\n");
+  syslog(LOG_DEBUG, "DEBUG: ES8311 width: I2S TX configured\n");
@@ -702 +702 @@ static int es8311_setsamplerate(FAR struct es8311_dev_s *priv)
-  syslog(LOG_INFO,
+  syslog(LOG_DEBUG,
@@ -703 +703 @@ static int es8311_setsamplerate(FAR struct es8311_dev_s *priv)
-         "INFO: ES8311 samplerate: begin rate=%" PRIu32
+         "DEBUG: ES8311 samplerate: begin rate=%" PRIu32

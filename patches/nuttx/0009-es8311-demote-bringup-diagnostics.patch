+  syslog(LOG_DEBUG, "DEBUG: ES8311 samplerate: I2S TX configured\n");
+  syslog(LOG_DEBUG, "DEBUG: ES8311 samplerate: codec clocks begin\n");
@@ -795 +795 @@ static int es8311_setsamplerate(FAR struct es8311_dev_s *priv)
-  syslog(LOG_INFO, "INFO: ES8311 samplerate: codec clocks complete\n");
+  syslog(LOG_DEBUG, "DEBUG: ES8311 samplerate: codec clocks complete\n");
@@ -1062 +1062 @@ static int es8311_configure(FAR struct audio_lowerhalf_s *dev,
-        syslog(LOG_INFO,
+        syslog(LOG_DEBUG,
@@ -1063 +1063 @@ static int es8311_configure(FAR struct audio_lowerhalf_s *dev,
-               "INFO: ES8311 configure output: mode/reset begin"

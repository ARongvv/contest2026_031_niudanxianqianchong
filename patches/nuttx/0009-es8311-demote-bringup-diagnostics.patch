-      syslog(LOG_INFO, "INFO: ES8311 start: worker create OK\n");
+      syslog(LOG_DEBUG, "DEBUG: ES8311 start: worker create OK\n");
@@ -2090 +2090 @@ static void *es8311_workerthread(pthread_addr_t pvarg)
-  syslog(LOG_INFO, "INFO: ES8311 worker: entered\n");

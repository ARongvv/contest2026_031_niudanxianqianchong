@@ -1069 +1069 @@ static int es8311_configure(FAR struct audio_lowerhalf_s *dev,
-        syslog(LOG_INFO, "INFO: ES8311 configure output: mode/reset done\n");
+        syslog(LOG_DEBUG, "DEBUG: ES8311 configure output: mode/reset done\n");
@@ -1076 +1076 @@ static int es8311_configure(FAR struct audio_lowerhalf_s *dev,
-        syslog(LOG_INFO,
+        syslog(LOG_DEBUG,

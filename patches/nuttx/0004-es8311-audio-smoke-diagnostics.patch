@@ -250,0 +273 @@ static int audio_smoke_prepare(FAR struct audio_smoke_state_s *state,
+  printf("[audio_smoke] mq open: %s\n", state->mq_name);
@@ -256,0 +280,2 @@ static int audio_smoke_prepare(FAR struct audio_smoke_state_s *state,
+  printf("[audio_smoke] mq open OK\n");
+  printf("[audio_smoke] register mq begin\n");
@@ -262,0 +288 @@ static int audio_smoke_prepare(FAR struct audio_smoke_state_s *state,
+  printf("[audio_smoke] register mq OK\n");
